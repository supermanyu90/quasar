{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "{src/**,venues/**}", "maxLambdaSize": "50mb" }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.+)", "dest": "/api?endpoint=$1", "headers": { "cache-control": "no-store" } },
    { "src": "/", "dest": "/public/index.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "src": "/(app\\.js|styles\\.css)", "dest": "/public/$1", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
